---
import PageLayout from '../../layouts/PageLayout.astro';
import SectionToggle from '../../components/SectionToggle.astro';
import MasonryGrid from '../../components/MasonryGrid.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

type Photo = CollectionEntry<'photos'>;
const newestFirst = (a: Photo, b: Photo) =>
  (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0);

const allPhotos = await getCollection('photos');
const inCategory = (category: string) => allPhotos.filter((p) => p.data.category === category);

const astrophotography = inCategory('astrophotography')
  .sort((a, b) => b.data.priority - a.data.priority || newestFirst(a, b));
const photography = inCategory('photography').sort(newestFirst);
---
<PageLayout title="Photos" activePage="photos">
  <SectionToggle />
  <MasonryGrid photos={astrophotography} category="astrophotography" />
  <MasonryGrid photos={photography} category="photography" />
</PageLayout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-category]');
  const grids = document.querySelectorAll<HTMLElement>('[data-grid]');

  const url = new URL(window.location.href);
  const initialCategory = url.searchParams.get('category') || 'astrophotography';
  let activeCategory = initialCategory;

  function setCategory(category: string) {
    activeCategory = category;
    url.searchParams.set('category', category);
    history.pushState(null, '', url);

    buttons.forEach((btn) => {
      const isActive = btn.dataset.category === category;
      btn.classList.toggle('font-bold', isActive);
      btn.classList.toggle('font-normal', !isActive);
      btn.style.opacity = isActive ? '1' : '0.4';
    });

    grids.forEach((grid) => {
      grid.style.display = grid.dataset.grid === category ? '' : 'none';
    });
  }

  // Initialize
  setCategory(activeCategory);

  // Handle browser back/forward navigation
  window.addEventListener('popstate', () => {
    const url = new URL(window.location.href);
    const category = url.searchParams.get('category') || 'astrophotography';
    setCategory(category);
  });

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      if (btn.dataset.category) setCategory(btn.dataset.category);
    });
  });
</script>