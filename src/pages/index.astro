---
import BaseLayout from '../layouts/BaseLayout.astro';

const navItems = [
  { label: 'Photos', href: '/photos' },
  { label: 'Projects', href: '/projects' },
  { label: 'Who?', href: '/about' },
];
---
<BaseLayout title="Home">
  <div class="min-h-screen flex flex-col items-center justify-center bg-page -translate-y-24">
    <h1
      class="text-ink font-bold tracking-tight"
      style="font-size: clamp(2.8rem, 6vw, 5rem);"
    >
      <button
        id="theme-toggle"
        aria-label="Toggle dark mode"
        class="select-none"
        style="-webkit-tap-highlight-color: transparent;"
      >
        Uri Darom
      </button>
    </h1>
    <nav
      class="flex items-center gap-3 mt-2 text-sm text-ink"
      style="font-size: clamp(1.0rem, 1vw, 3rem);"
    >
      {navItems.map((item, i) => (
        <>
          {i > 0 && <span class="select-none">•</span>}
          <a href={item.href} class="hover:opacity-60 transition-opacity duration-200">
            {item.label}
          </a>
        </>
      ))}
    </nav>
  </div>
</BaseLayout>

<script>
  document.getElementById('theme-toggle')!.addEventListener('click', () => {
    const dark = document.documentElement.classList.toggle('dark');
    localStorage.setItem('theme', dark ? 'dark' : 'light');
  });
</script>
